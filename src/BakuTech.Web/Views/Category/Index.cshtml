@model BakuTech.Web.ViewModels.Category.CategoryPageViewModel

@using System.Globalization
@using BakuTech.Web.Services
@inject LocService localizer

@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    var categoryName = currentCulture switch
    {
        "en" => Model.Category.NameEn,
        "ru" => Model.Category.NameRu,
        _ => Model.Category.NameAz
    };

    ViewData["Title"] = categoryName;
}

<div id="product-category" class="container">
    <nav aria-label="breadcrumb">
        <ul class="breadcrumb rm-breadcrumb">

            <li class="breadcrumb-item rm-breadcrumb-item">
                <a asp-controller="Home" asp-action="Index">
                    <i class="fa fa-home"></i>
                </a>
            </li>

            <li class="breadcrumb-item rm-breadcrumb-item">
                @categoryName
            </li>

        </ul>
    </nav>


    <div class="content-top-box">
    </div>
    <main>
        <div class="row">
            <div class="col-12 rm-page-title">
                <h1>@categoryName</h1>
            </div>
        </div>
        <div class="row no-gutters">
            
            <aside id="column-left" class="col-lg-3">
                <div class="rm-column-box h-100">
                    <div class="ocf-container ocf-category-173 ocf-theme-light-block ocf-mobile-1 ocf-mobile-left ocf-vertical ocf-left" id="ocf-module-1">

                        <div class="ocf-content">
                            <div class="ocf-header">
                                <div class="BakuTech-filter-header-title">
                                    <span class="BakuTech-filter-icon" aria-hidden="true">
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                    </span>

                                    <span>
                                        @localizer.GetLocalizedHtmlString("Filter")
                                    </span>
                                </div>

                                <button type="button"
                                        id="BakuTech-filter-close"
                                        class="BakuTech-filter-close"
                                        aria-label="@localizer.GetLocalizedHtmlString("CloseFilter")">
                                    <span></span>
                                    <span></span>
                                </button>
                            </div>

                            <form method="get"  class="BakuTech-filter-form">

                                
                                <div class="ocf-body">

                                    <div class="ocf-filter-list ocf-clearfix">









                                        <div class="BakuTech-filter">
                                            <div class="BakuTech-filter-header">
                                                <span class="BakuTech-filter-title">
                                                    @localizer.GetLocalizedHtmlString("Manufacturer")
                                                </span>
                                            </div>

                                            <div class="BakuTech-filter-content">

                                                @{
                                                    var brands = Model.FilterOptions.Brands;
                                                    var visibleBrandCount = 5;
                                                }

                                                @if (brands.Any())
                                                {
                                                    <div class="BakuTech-brand-list">

                                                        @for (var i = 0; i < brands.Count; i++)
                                                        {
                                                            var brand = brands[i];

                                                            var isSelected = Context.Request.Query["brandIds"]
                                                            .Contains(brand.BrandId.ToString());

                                                            <label class="BakuTech-filter-option @(i >= visibleBrandCount ? "BakuTech-brand-hidden" : "")">

                                                                <input type="checkbox"
                                                                       name="brandIds"
                                                                       value="@brand.BrandId"
                                                                @(isSelected ? "checked" : null) />

                                                                <span class="BakuTech-checkbox"></span>

                                                                <span class="BakuTech-filter-name">
                                                                    @brand.Name
                                                                </span>

                                                                <span class="BakuTech-filter-count">
                                                                    @brand.ProductCount
                                                                </span>

                                                            </label>
                                                        }

                                                    </div>

                                                    @if (brands.Count > visibleBrandCount)
                                                    {
                                                        <button type="button"
                                                                id="BakuTech-show-brands"
                                                                class="BakuTech-show-more">

                                                            <span class="BakuTech-show-more-text">
                                                                @localizer.GetLocalizedHtmlString("ShowMoreBrands")
                                                                @(brands.Count - visibleBrandCount)
                                                            </span>

                                                            <span class="BakuTech-show-more-arrow"></span>

                                                        </button>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="BakuTech-filter-empty">
                                                        @localizer.GetLocalizedHtmlString("ManufacturerNotFound")
                                                    </div>
                                                }

                                            </div>
                                        </div>


                                        <div class="BakuTech-filter BakuTech-price-filter">

                                            <div class="BakuTech-filter-header">
                                                <span class="BakuTech-filter-title">
                                                    @localizer.GetLocalizedHtmlString("Price")
                                                </span>
                                            </div>

                                            <div class="BakuTech-filter-content">

                                                @{
                                                    var filterMinPrice = Model.FilterOptions.MinPrice
                                                    .ToString(CultureInfo.InvariantCulture);

                                                    var filterMaxPrice = Model.FilterOptions.MaxPrice
                                                    .ToString(CultureInfo.InvariantCulture);

                                                    var selectedMinPrice =
                                                    Context.Request.Query["minPrice"].FirstOrDefault();

                                                    var selectedMaxPrice =
                                                    Context.Request.Query["maxPrice"].FirstOrDefault();
                                                }

                                                <div class="BakuTech-price-inputs">

                                                    <div class="BakuTech-price-input-wrapper">
                                                        <input type="number"
                                                               id="BakuTech-min-price"
                                                               name="minPrice"
                                                               class="BakuTech-price-input"
                                                               min="@filterMinPrice"
                                                               max="@filterMaxPrice"
                                                               step="0.01"
                                                               value="@selectedMinPrice"
                                                               placeholder="@filterMinPrice" />

                                                        <span class="BakuTech-price-currency">₼</span>
                                                    </div>

                                                    <span class="BakuTech-price-separator">-</span>

                                                    <div class="BakuTech-price-input-wrapper">
                                                        <input type="number"
                                                               id="BakuTech-max-price"
                                                               name="maxPrice"
                                                               class="BakuTech-price-input"
                                                               min="@filterMinPrice"
                                                               max="@filterMaxPrice"
                                                               step="0.01"
                                                               value="@selectedMaxPrice"
                                                               placeholder="@filterMaxPrice" />

                                                        <span class="BakuTech-price-currency">₼</span>
                                                    </div>

                                                </div>

                                                <div class="BakuTech-price-range">

                                                    <div id="BakuTech-range-progress"
                                                         class="BakuTech-range-progress"></div>

                                                    <input type="range"
                                                           id="BakuTech-min-range"
                                                           class="BakuTech-range"
                                                           min="@filterMinPrice"
                                                           max="@filterMaxPrice"
                                                           step="0.01"
                                                           value="@(selectedMinPrice ?? filterMinPrice)" />

                                                    <input type="range"
                                                           id="BakuTech-max-range"
                                                           class="BakuTech-range"
                                                           min="@filterMinPrice"
                                                           max="@filterMaxPrice"
                                                           step="0.01"
                                                           value="@(selectedMaxPrice ?? filterMaxPrice)" />

                                                </div>

                                            </div>

                                        </div>



                                        <div class="BakuTech-filter BakuTech-stock-filter">

                                            <div class="BakuTech-filter-header">
                                                <span class="BakuTech-filter-title">
                                                    @localizer.GetLocalizedHtmlString("Stock")
                                                </span>
                                            </div>

                                            <div class="BakuTech-filter-content">

                                                <label class="BakuTech-filter-option">
                                                    <input type="radio"
                                                           name="inStock"
                                                           value="true"
                                                    @(Context.Request.Query["inStock"] == "true" ? "checked" : null) />

                                                    <span class="BakuTech-radio"></span>

                                                    @localizer.GetLocalizedHtmlString("InStock")

                                                    <span class="BakuTech-filter-count">
                                                        @Model.FilterOptions.InStockCount
                                                    </span>
                                                </label>

                                                <label class="BakuTech-filter-option">
                                                    <input type="radio"
                                                           name="inStock"
                                                           value="false"
                                                    @(Context.Request.Query["inStock"] == "false" ? "checked" : null) />

                                                    <span class="BakuTech-radio"></span>

                                                    @localizer.GetLocalizedHtmlString("OutOfStock")

                                                    <span class="BakuTech-filter-count">
                                                        @Model.FilterOptions.OutOfStockCount
                                                    </span>
                                                </label>

                                            </div>

                                        </div>

                                    </div>
                                </div>

                                <div class="BakuTech-filter-footer">

                                    <button type="button"
                                            id="BakuTech-reset-filters"
                                            class="BakuTech-filter-reset">
                                        @localizer.GetLocalizedHtmlString("Reset")
                                    </button>

                                    <button type="submit"
                                            class="BakuTech-filter-submit">
                                        @localizer.GetLocalizedHtmlString("ApplyFilters")
                                    </button>

                                </div>
                            </form>
                        </div>

                        <div class="ocf-is-mobile"></div>



                        

                    </div>
                </div>
            </aside>

            <div id="content" class="col-lg-9">
                <div class="rm-content rm-category h-100">
                    <!-- Mobile Category / Filter Buttons -->
                    <div class="rm-category-buttons d-flex d-lg-none justify-content-between sticky-top">

                        <div class="static_button_ocfilter order-1">

                            <div class="ocfilter-mobile-handle">

                                <button type="button"
                                        id="BakuTech-filter-open"
                                        class="rm-btn dark BakuTech-mobile-filter-button">

                                    <span class="BakuTech-mobile-filter-icon" aria-hidden="true">
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                    </span>

                                    <span class="rm-btn-text">
                                        @localizer.GetLocalizedHtmlString("Filter")
                                    </span>

                                </button>

                            </div>

                        </div>


                        <button type="button"
                                style="border: 1px solid #e9e9e9"
                                id="BakuTech-category-catalog-button"
                                class="rm-btn BakuTech-mobile-filter-button ">

                            <span class="rm-btn-icon">
                                <img src="~/catalog/view/theme/oct_remarket/img/sprite.svg#include--category-catalog-icon"
                                     alt="@localizer.GetLocalizedHtmlString("ProductCatalog")"
                                     width="15"
                                     height="14">
                            </span>

                            <span class="rm-btn-text">
                                @localizer.GetLocalizedHtmlString("ProductCatalog")
                            </span>

                        </button>

                    </div>



                    <!-- Child Categories -->
                    @if (Model.ChildCategories.Any())
                    {
                        <div class="rm-subcategory">

                            <div class="row no-gutters rm-subcategory-row">

                                @foreach (var category in Model.ChildCategories)
                                {
                                    <div class="col-6 col-sm-4 col-lg-3 col-xl-2 rm-category-wall-item">

                                        <a href="@Url.RouteUrl("category", new
{
    culture = currentCulture,
    slug = currentCulture == "en"
        ? category.SlugEn
        : currentCulture == "ru"
            ? category.SlugRu
            : category.SlugAz
})"
                                           class="d-flex flex-column justify-content-between align-items-center text-center">
                                            @if (!string.IsNullOrWhiteSpace(category.Image))
                                            {
                                                <span class="rm-category-wall-item-image">

                                                    <img src="@category.Image"
                                                         alt="@(currentCulture == "en"
                                                        ? category.NameEn
                                                        : currentCulture == "ru"
                                                            ? category.NameRu
                                                            : category.NameAz)"
                                                              title="@(currentCulture == "en"
                                                          ? category.NameEn
                                                          : currentCulture == "ru"
                                                              ? category.NameRu
                                                              : category.NameAz)"
                                                         width="95"
                                                         height="95">                                            

                                                </span>
                                            }

                                            <span>
                                                @(currentCulture == "en"
                                                    ? category.NameEn
                                                    : currentCulture == "ru"
                                                    ? category.NameRu
                                                    : category.NameAz)
                                            </span>

                                        </a>

                                    </div>
                                }

                            </div>

                        </div>
                    }
                    <div class="row no-gutters rm-category-products">

                        @if (Model.Products.Items.Any())
                        {
                            @foreach (var product in Model.Products.Items)
                            {
                                <partial name="_ProductCardGrid" model="product" />
                            }
                        }
                        else
                        {
                            <div class="col-12 py-5 text-center">
                                <h4>
                                    @localizer.GetLocalizedHtmlString("ProductsNotFound")
                                </h4>

                                <p class="text-muted">
                                    @localizer.GetLocalizedHtmlString("NoProductsInCategory")
                                </p>
                            </div>
                        }

                    </div>


                    @{
                        string BuildPaginationUrl(int page)
                        {
                            var queryParams =
                            new List<KeyValuePair<string, string?>>();

                            foreach (var query in Context.Request.Query)
                            {
                                if (query.Key.Equals("page", StringComparison.OrdinalIgnoreCase) ||
                                query.Key.Equals("pageSize", StringComparison.OrdinalIgnoreCase))
                                {
                                    continue;
                                }

                                foreach (var value in query.Value)
                                {
                                    queryParams.Add(
                                    new KeyValuePair<string, string?>(
                                    query.Key,
                                    value));
                                }
                            }

                            queryParams.Add(
                            new KeyValuePair<string, string?>(
                            "page",
                            page.ToString()));

                            queryParams.Add(
                            new KeyValuePair<string, string?>(
                            "pageSize",
                            Model.Products.PageSize.ToString()));

                            return Microsoft.AspNetCore.WebUtilities.QueryHelpers
                            .AddQueryString(
                            Context.Request.Path.Value ?? "/Category",
                            queryParams);
                        }
                    }

                    @if (Model.Products.TotalPages > 1)
                    {
                        <ul class="pagination">

                            @if (Model.Products.HasPreviousPage)
                            {
                                <li>
                                    <a href="@BuildPaginationUrl(Model.Products.CurrentPage - 1)">
                                        &lt;
                                    </a>
                                </li>
                            }

                            @for (var i = 1; i <= Model.Products.TotalPages; i++)
                            {
                                if (i == Model.Products.CurrentPage)
                                {
                                    <li class="active">
                                        <span>@i</span>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a href="@BuildPaginationUrl(i)">
                                            @i
                                        </a>
                                    </li>
                                }
                            }

                            @if (Model.Products.HasNextPage)
                            {
                                <li>
                                    <a href="@BuildPaginationUrl(Model.Products.CurrentPage + 1)">
                                        &gt;
                                    </a>
                                </li>
                            }

                        </ul>
                    }
                </div>
            </div>

        </div>
    </main>


</div>
